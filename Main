local tHealthText = Instance.new("TextLabel")
tHealthText.Size = UDim2.new(1, 0, 1, 0); tHealthText.BackgroundTransparency = 1; tHealthText.Text = "—"
tHealthText.TextColor3 = Color3.new(1,1,1); tHealthText.Font = Enum.Font.GothamBold; tHealthText.TextSize = 10; tHealthText.Parent = tHealthBg

local thDragging = false
local thDragStart, thStartPos
targetHudFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		thDragging = true; thDragStart = input.Position; thStartPos = targetHudFrame.Position
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if thDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - thDragStart
		targetHudFrame.Position = UDim2.new(thStartPos.X.Scale, thStartPos.X.Offset + delta.X, thStartPos.Y.Scale, thStartPos.Y.Offset + delta.Y)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then thDragging = false end
end)

RunService.RenderStepped:Connect(function()
	if not settings.showTargetHud then targetHudFrame.Visible = false return end
	targetHudFrame.Visible = true
	local camera = workspace.CurrentCamera
	local mousePos = UserInputService:GetMouseLocation()
	local closest, closestDist = nil, 150
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local head = plr.Character:FindFirstChild("Head")
			if hum and hum.Health > 0 and head then
				local sp, onScreen = camera:WorldToViewportPoint(head.Position)
				if onScreen then
					local dist = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
					if dist < closestDist then closestDist = dist; closest = plr end
				end
			end
		end
	end
	if closest then
		local hum = closest.Character:FindFirstChildOfClass("Humanoid")
		tName.Text = closest.Name
		local hp = math.floor(hum.Health / hum.MaxHealth * 100)
		tHealthFill.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
		tHealthFill.BackgroundColor3 = hp > 50 and COL.on or (hp > 20 and Color3.fromRGB(255,200,80) or COL.close)
		tHealthText.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
	else
		tName.Text = "No target"
		tHealthFill.Size = UDim2.new(0, 0, 1, 0)
		tHealthText.Text = "—"
	end
end)

