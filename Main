			local tpBtn=Instance.new("TextButton") tpBtn.Size=UDim2.new(0,54,0,26) tpBtn.Position=UDim2.new(1,-184,0.5,0) tpBtn.AnchorPoint=Vector2.new(0,0.5) tpBtn.BackgroundColor3=COL.accent tpBtn.Text="TP" tpBtn.TextColor3=Color3.new(1,1,1) tpBtn.Font=Enum.Font.GothamBold tpBtn.TextSize=11 tpBtn.AutoButtonColor=false tpBtn.Parent=row
			Instance.new("UICorner",tpBtn).CornerRadius=UDim.new(0,7) reg(tpBtn,"accent")

