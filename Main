makeSectionLabel(visScroll,"WORLD",10)
makeToggleButton(visScroll,"fullbright","Fullbright",11,function() setFullbright(not state.fullbright) end)
makeToggleButton(visScroll,"noFog","No Fog",12,function() setNoFog(not state.noFog) end)
makeToggleButton(visScroll,"customSky","Custom Skybox",13,function() setCustomSky(not state.customSky) end)

-- Sky Preset dropdown
