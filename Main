	for _, v in ipairs(savedEmotesHolder:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
	for i, id in ipairs(settings.savedEmotes) do
		local btn = Instance.new("TextButton") btn.Size = UDim2.new(1,0,0,32); btn.BackgroundColor3 = COL.panel; btn.Text = "Play Emote: "..id; btn.TextColor3 = COL.text; btn.Font = Enum.Font.Gotham; btn.TextSize = 12; btn.LayoutOrder = i; btn.Parent = savedEmotesHolder
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8) reg(btn,"panel")
		btn.MouseButton1Click:Connect(function() playEmote(id) end)
	end
end
