local function notify(text, on)
	notifOrder = notifOrder + 1
	local frame = Instance.new("Frame") frame.Size = UDim2.new(1, 0, 0, 34) frame.BackgroundColor3 = COL.panel frame.BackgroundTransparency = 0.1 frame.BorderSizePixel = 0 frame.LayoutOrder = notifOrder frame.Parent = notifHolder Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	local stroke = Instance.new("UIStroke") stroke.Color = (on==true and COL.on) or (on==false and COL.close) or COL.accent stroke.Thickness = 1 stroke.Transparency = 0.2 stroke.Parent = frame
	local dot = Instance.new("Frame") dot.Size = UDim2.new(0, 8, 0, 8) dot.Position = UDim2.new(0, 10, 0.5, 0) dot.AnchorPoint = Vector2.new(0, 0.5) dot.BackgroundColor3 = stroke.Color dot.BorderSizePixel = 0 dot.Parent = frame Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
	local label = Instance.new("TextLabel") label.Size = UDim2.new(1, -30, 1, 0) label.Position = UDim2.new(0, 26, 0, 0) label.BackgroundTransparency = 1 label.Text = text label.TextColor3 = COL.text label.Font = Enum.Font.GothamMedium label.TextSize = 11 label.TextXAlignment = Enum.TextXAlignment.Left label.Parent = frame
	frame.Position = UDim2.new(1, 30, 0, 0) TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0,0,0,0)}):Play()
	task.delay(2.5, function() if frame and frame.Parent then local tw = TweenService:Create(frame, TweenInfo.new(0.22), {Position = UDim2.new(1,30,0,0), BackgroundTransparency = 1}) tw:Play() tw.Completed:Connect(function() frame:Destroy() end) end end)
end

