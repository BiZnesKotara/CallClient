Instance.new("UICorner", invisBtn).CornerRadius = UDim.new(0,8) reg(invisBtn, "panel")
local invisLbl = Instance.new("TextLabel") invisLbl.Size = UDim2.new(1,-70,1,0); invisLbl.Position = UDim2.new(0,12,0,0); invisLbl.BackgroundTransparency = 1; invisLbl.Text = "Invisible"; invisLbl.TextColor3 = COL.text; invisLbl.Font = Enum.Font.GothamMedium; invisLbl.TextSize = 13; invisLbl.TextXAlignment = Enum.TextXAlignment.Left; invisLbl.Parent = invisBtn reg(invisLbl,"text","TextColor3")
local invisInd = Instance.new("Frame") invisInd.Size = UDim2.new(0,42,0,22); invisInd.Position = UDim2.new(1,-52,0.5,0); invisInd.AnchorPoint = Vector2.new(0,0.5); invisInd.BackgroundColor3 = COL.off; invisInd.BorderSizePixel = 0; invisInd.Parent = invisBtn Instance.new("UICorner",invisInd).CornerRadius = UDim.new(1,0)
local invisIndLbl = Instance.new("TextLabel") invisIndLbl.Size = UDim2.new(1,0,1,0); invisIndLbl.BackgroundTransparency = 1; invisIndLbl.Text = "OFF"; invisIndLbl.TextColor3 = Color3.new(1,1,1); invisIndLbl.Font = Enum.Font.GothamBold; invisIndLbl.TextSize = 10; invisIndLbl.Parent = invisInd
local function refreshInvis() invisInd.BackgroundColor3 = state.invisible and COL.on or COL.off invisIndLbl.Text = state.invisible and "ON" or "OFF" end
invisBtn.MouseButton1Click:Connect(function() toggleInvisible() refreshInvis() end)
makeSlider(visScroll,"espFill","Fill Transparency",0,100,5,3,function(v) return tostring(v).."%" end)

-- ====== ВКЛАДКА THEME ======
local themePage,themeScroll=makePage()
makeSectionLabel(themeScroll,"SELECT THEME",1)
local themeNames={"Purple","Dark","Ocean","Rose"}
for i,name in ipairs(themeNames) do
	local btn=Instance.new("TextButton") btn.Size=UDim2.new(1,0,0,38) btn.BackgroundColor3=COL.panel btn.Text="" btn.AutoButtonColor=false btn.LayoutOrder=i+1 btn.Parent=themeScroll
	Instance.new("UICorner",btn).CornerRadius=UDim.new(0,8) reg(btn,"panel")
	local lbl=Instance.new("TextLabel") lbl.Size=UDim2.new(1,-60,1,0) lbl.Position=UDim2.new(0,14,0,0) lbl.BackgroundTransparency=1 lbl.Text=name lbl.TextColor3=COL.text lbl.Font=Enum.Font.GothamMedium lbl.TextSize=13 lbl.TextXAlignment=Enum.TextXAlignment.Left lbl.Parent=btn reg(lbl,"text","TextColor3")
	local preview=Instance.new("Frame") preview.Size=UDim2.new(0,22,0,22) preview.Position=UDim2.new(1,-36,0.5,0) preview.AnchorPoint=Vector2.new(0,0.5) preview.BackgroundColor3=Themes[name].accent preview.BorderSizePixel=0 preview.Parent=btn
	Instance.new("UICorner",preview).CornerRadius=UDim.new(0,5)
	btn.MouseButton1Click:Connect(function() applyTheme(Themes[name]) end)
end

-- ====== ВКЛАДКИ ======
local keybindsTabBtn=makeTab("Keybinds",1) local commandsTabBtn=makeTab("Commands",2) local animTabBtn=makeTab("Animations",3) local playersTabBtn=makeTab("Players",4) local visualsTabBtn=makeTab("Visuals",5) local themeTabBtn=makeTab("Theme",6)
local pages={ Keybinds=keybindsPage,Commands=commandsPage,Animations=animPage,Players=playersPage,Visuals=visualsPage,Theme=themePage }
local function setTab(tabName)
	for tName,t in pairs(tabs) do local active=(tName==tabName) t.button:SetAttribute("Active",active) t.button.BackgroundColor3=active and COL.itemHov or COL.item t.button.TextColor3=active and COL.text or COL.muted t.marker.Visible=active t.marker.Size=active and UDim2.new(0,3,0,20) or UDim2.new(0,3,0,0) end
	for pName,page in pairs(pages) do page.Visible=(pName==tabName) end
end
keybindsTabBtn.MouseButton1Click:Connect(function() setTab("Keybinds") end) commandsTabBtn.MouseButton1Click:Connect(function() setTab("Commands") end) animTabBtn.MouseButton1Click:Connect(function() setTab("Animations") end) playersTabBtn.MouseButton1Click:Connect(function() setTab("Players") end) visualsTabBtn.MouseButton1Click:Connect(function() setTab("Visuals") end) themeTabBtn.MouseButton1Click:Connect(function() setTab("Theme") end) setTab("Keybinds")

local isOpen=false
local function setOpen(newState)
	isOpen=newState
	if newState then mainFrame.Visible=true mainFrame.Size=UDim2.new(0,MAIN_W,0,MAIN_H-20) TweenService:Create(mainFrame,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(0,MAIN_W,0,MAIN_H)}):Play()
	else local tween=TweenService:Create(mainFrame,TweenInfo.new(0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Size=UDim2.new(0,MAIN_W,0,MAIN_H-20)}) tween:Play() tween.Completed:Connect(function() if not isOpen then mainFrame.Visible=false end end) end
end

UserInputService.InputBegan:Connect(function(input,gameProcessed)
	if rebinding then
		if input.UserInputType~=Enum.UserInputType.Keyboard then return end
		if input.KeyCode==Enum.KeyCode.Unknown then return end
		if input.KeyCode==Enum.KeyCode.Delete then rebinding=nil updateKeybindLabels() refreshHUD() return end
		binds[rebinding]=input.KeyCode
		local setFor = rebinding
		rebinding=nil
		updateKeybindLabels(); refreshHUD() rebuildKeybindList()
		notify("Bind set: "..bindNames[setFor].." -> "..keyName(binds[setFor]), true)
		return
	end
	if input.KeyCode==binds.toggle then if gameProcessed and not isOpen then return end setOpen(not isOpen) return end
	if binds.close and input.KeyCode==binds.close and isOpen then if gameProcessed then return end setOpen(false) return end
	if binds.fly and input.KeyCode==binds.fly then if gameProcessed then return end toggleFly() notify("Fly: "..(state.fly and "ON" or "OFF"), state.fly) return end
	if binds.noclip and input.KeyCode==binds.noclip then if gameProcessed then return end toggleNoclip() notify("Noclip: "..(state.noclip and "ON" or "OFF"), state.noclip) return end
	if binds.fling and input.KeyCode==binds.fling then if gameProcessed then return end toggleFling() notify("Fling: "..(state.fling and "ON" or "OFF"), state.fling) return end
	if binds.esp and input.KeyCode==binds.esp then if gameProcessed then return end toggleESP() notify("ESP: "..(state.esp and "ON" or "OFF"), state.esp) return end
	if binds.aim and input.KeyCode==binds.aim then if gameProcessed then return end toggleAim() notify("Aim: "..(state.aim and "ON" or "OFF"), state.aim) return end
end)

closeBtn.MouseButton1Click:Connect(function() setOpen(false) end)

local dragging=false
local dragStart,startPos
header.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true dragStart=input.Position startPos=mainFrame.Position end end)
UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then local delta=input.Position-dragStart mainFrame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y) end end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
