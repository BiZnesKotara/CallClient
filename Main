local char,hrp,humanoid
local flyConnection,noclipConnection,espThread,aimConnection,antiflingConn
local flyBodyVelocity,flyBodyGyro
local espHighlights={}
local flinging=false
local flingConnection,flingDied
local targetFlingConnection = nil
local targetFlingPlayer = nil

local function refreshCharacter()
	char=player.Character
	if not char then return end
	hrp=char:FindFirstChild("HumanoidRootPart")
	humanoid=char:FindFirstChildOfClass("Humanoid")
end
refreshCharacter()

local stopTrail, startTrail, stopFling, stopFly

-- ====== GUI ======
local screenGui=Instance.new("ScreenGui") screenGui.Name="CallClient" screenGui.ResetOnSpawn=false screenGui.IgnoreGuiInset=true screenGui.DisplayOrder=999 screenGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling screenGui.Parent=playerGui

-- Уведомления
local notifHolder = Instance.new("Frame")
notifHolder.Name = "Notifications"
notifHolder.Size = UDim2.new(0, 240, 1, -20)
notifHolder.Position = UDim2.new(1, -250, 0, 10)
notifHolder.BackgroundTransparency = 1
notifHolder.Parent = screenGui
local notifLayout = Instance.new("UIListLayout")
notifLayout.Padding = UDim.new(0, 6)
notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
notifLayout.Parent = notifHolder
local notifOrder = 0
local function notify(text, on)
	notifOrder = notifOrder + 1
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 34)
	frame.BackgroundColor3 = COL.panel
	frame.BackgroundTransparency = 0.1
	frame.BorderSizePixel = 0
	frame.LayoutOrder = notifOrder
	frame.Parent = notifHolder
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	local stroke = Instance.new("UIStroke")
	stroke.Color = (on==true and COL.on) or (on==false and COL.close) or COL.accent
	stroke.Thickness = 1; stroke.Transparency = 0.2; stroke.Parent = frame
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 8, 0, 8)
	dot.Position = UDim2.new(0, 10, 0.5, 0)
	dot.AnchorPoint = Vector2.new(0, 0.5)
	dot.BackgroundColor3 = stroke.Color
	dot.BorderSizePixel = 0
	dot.Parent = frame
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -30, 1, 0)
	label.Position = UDim2.new(0, 26, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = COL.text
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame
	frame.Position = UDim2.new(1, 30, 0, 0)
	TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0,0,0,0)}):Play()
	task.delay(2.5, function()
		if frame and frame.Parent then
			local tw = TweenService:Create(frame, TweenInfo.new(0.22), {Position = UDim2.new(1,30,0,0), BackgroundTransparency = 1})
			tw:Play()
			tw.Completed:Connect(function() frame:Destroy() end)
		end
	end)
end

-- ====== FLY ======
function stopFly()
	state.fly=false
	if flyConnection then flyConnection:Disconnect() flyConnection=nil end
	if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity=nil end
	if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro=nil end
	if humanoid then humanoid.PlatformStand=false end
end
local function startFly()
	refreshCharacter()
	if not hrp or not humanoid then return end
	state.fly=true humanoid.PlatformStand=true
	flyBodyVelocity=Instance.new("BodyVelocity") flyBodyVelocity.MaxForce=Vector3.new(1e5,1e5,1e5) flyBodyVelocity.Velocity=Vector3.zero flyBodyVelocity.Parent=hrp
	flyBodyGyro=Instance.new("BodyGyro") flyBodyGyro.MaxTorque=Vector3.new(1e5,1e5,1e5) flyBodyGyro.P=1000 flyBodyGyro.D=50 flyBodyGyro.CFrame=hrp.CFrame flyBodyGyro.Parent=hrp
	local camera=workspace.CurrentCamera
	flyConnection=RunService.RenderStepped:Connect(function()
		if not hrp or not humanoid or humanoid.Health<=0 then stopFly() return end
		local moveDir=Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir+=camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir-=camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir-=camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir+=camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir+=Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir-=Vector3.yAxis end
		if moveDir.Magnitude>0 then moveDir=moveDir.Unit end
		flyBodyVelocity.Velocity=moveDir*settings.flySpeed
		flyBodyGyro.CFrame=camera.CFrame
	end)
end
local function toggleFly() if state.fly then stopFly() else startFly() end return state.fly end

-- ====== NOCLIP ======
local function stopNoclip()
	state.noclip=false
	if noclipConnection then noclipConnection:Disconnect() noclipConnection=nil end
end
local function startNoclip()
	refreshCharacter() state.noclip=true
	noclipConnection=RunService.Stepped:Connect(function()
		local c=player.Character if not c then return end
		for _,part in ipairs(c:GetDescendants()) do if part:IsA("BasePart") and part.CanCollide then part.CanCollide=false end end
	end)
end
local function toggleNoclip() if state.noclip then stopNoclip() else startNoclip() end return state.noclip end

-- ====== FLING ======
function stopFling()
	flinging = false
	state.fling = false
	if flingConnection then
		pcall(function() task.cancel(flingConnection) end)
		flingConnection = nil
	end
	if flingDied then flingDied:Disconnect() flingDied = nil end
	refreshCharacter()
	if not char then return end
	for _, v in ipairs(char:GetDescendants()) do
		if v.Name:find("IYFling") then v:Destroy() end
	end
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			v.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
			v.Massless = false
			v.CanCollide = true
			v.AssemblyLinearVelocity = Vector3.zero
			v.AssemblyAngularVelocity = Vector3.zero
			v.RotVelocity = Vector3.zero
		end
	end
	if humanoid then
		humanoid.AutoRotate = true
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	if hrp then
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	notify("Fling OFF", false)
end

local function startFling(silent)
	refreshCharacter()
	if not hrp or not humanoid then return end
	flinging = true
	state.fling = true

	for _, child in ipairs(char:GetDescendants()) do
		if child:IsA("BasePart") then
			if child == hrp then
				child.CanCollide = true
				child.Massless = false
				child.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
			else
				child.CanCollide = false
				child.Massless = true
			end
		end
	end
	if char:FindFirstChild("Torso") then
		char.Torso.CanCollide = false
		char.Torso.Massless = true
	end

	humanoid.AutoRotate = false
	humanoid.PlatformStand = false

	local bambam = Instance.new("BodyAngularVelocity")
	bambam.Name = "IYFling_" .. math.random(1, 9999)
	bambam.Parent = hrp
	bambam.AngularVelocity = Vector3.new(0, settings.flingPower, 0)
	bambam.MaxTorque = Vector3.new(0, math.huge, 0)
	bambam.P = math.huge

	flingDied = humanoid.Died:Connect(function()
		if stopFling then stopFling() end
	end)

	flingConnection = task.spawn(function()
		while flinging do
			if not hrp or not humanoid or humanoid.Health <= 0 then break end
			if bambam and bambam.Parent then
				bambam.AngularVelocity = Vector3.new(0, settings.flingPower, 0)
			end
			local v = hrp.AssemblyLinearVelocity
			hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
			task.wait(0.2)
			if bambam and bambam.Parent then
				bambam.AngularVelocity = Vector3.zero
			end
			if hrp then
				local v2 = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(v2.X, 0, v2.Z)
			end
			task.wait(0.1)
		end
	end)
	if not silent then notify("Fling ON", true) end
end

local function toggleFling()
	if flinging then stopFling() else startFling() end
	return flinging
end

-- ====== TARGET FLING ======
local targetFlingConnection = nil
local targetFlingPlayer = nil
local targetFlingBV = nil

local function stopTargetFling()
	if targetFlingConnection then
		targetFlingConnection:Disconnect()
		targetFlingConnection = nil
	end
	if targetFlingBV then
		targetFlingBV:Destroy()
		targetFlingBV = nil
	end
	targetFlingPlayer = nil
	if flinging then stopFling() end
end

local function startTargetFling(target)
	stopTargetFling()
	if not target or not target.Character or not hrp or not humanoid then return end
	targetFlingPlayer = target

	startFling(true)
	notify("Target Fling: "..target.Name, true)

	-- Создаем BodyVelocity
	targetFlingBV = Instance.new("BodyVelocity")
	targetFlingBV.Name = "TargetFlingVelocity"
	targetFlingBV.Parent = hrp

	targetFlingConnection = RunService.Heartbeat:Connect(function()
		refreshCharacter()
		if not hrp or not humanoid or not targetFlingPlayer or not targetFlingPlayer.Character then
			stopTargetFling()
			return
		end

		local tHrp = targetFlingPlayer.Character:FindFirstChild("HumanoidRootPart")
		if tHrp and targetFlingBV then
			local direction = (tHrp.Position - hrp.Position)
			local horizontalDir = Vector3.new(direction.X, 0, direction.Z)

			-- Настраиваем силу, чтобы не тонуть
			targetFlingBV.MaxForce = Vector3.new(1e5, 1e5, 1e5) -- Теперь держим и высоту тоже!

			if horizontalDir.Magnitude > 2 then
				horizontalDir = horizontalDir.Unit
				-- Летим к цели
				targetFlingBV.Velocity = horizontalDir * 80
			else
				-- Если мы рядом, просто висим на месте (не падаем)
				targetFlingBV.Velocity = Vector3.zero
			end
		end
	end)
end
-- ====== ANTI-FLING ======
local function stopAntifling()
	state.antifling=false
	if antiflingConn then antiflingConn:Disconnect() antiflingConn=nil end
end
local function startAntifling()
	state.antifling=true
	antiflingConn=RunService.Stepped:Connect(function()
		for _,plr in ipairs(Players:GetPlayers()) do
			if plr~=player and plr.Character then
				for _,part in ipairs(plr.Character:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then part.CanCollide=false end
				end
			end
		end
	end)
end
local function toggleAntifling() if state.antifling then stopAntifling() else startAntifling() end return state.antifling end

-- ====== AIM ======
local function stopAim()
	state.aim=false
	if aimConnection then aimConnection:Disconnect() aimConnection=nil end
end
local function startAim()
	state.aim=true
	aimConnection=RunService.RenderStepped:Connect(function()
		if not state.aim then return end
		refreshCharacter()
		if not hrp or not humanoid or humanoid.Health<=0 then return end
		local camera=workspace.CurrentCamera
		local center=Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
		local best,bestDist=nil,math.huge
		for _,plr in ipairs(Players:GetPlayers()) do
			if plr~=player and plr.Character then
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					local targetPart=plr.Character:FindFirstChild(settings.aimTarget) or plr.Character:FindFirstChild("Head")
					if targetPart then
						local worldDist=(targetPart.Position - hrp.Position).Magnitude
						if worldDist <= settings.aimMaxDist then
							local screenPos,onScreen=camera:WorldToViewportPoint(targetPart.Position)
							if onScreen then
								local dist=(center-Vector2.new(screenPos.X,screenPos.Y)).Magnitude
								if dist<settings.aimFov and dist<bestDist then
									local rayParams = RaycastParams.new()
									rayParams.FilterType = Enum.RaycastFilterType.Exclude
									rayParams.FilterDescendantsInstances = {char}
									local rayResult = workspace:Raycast(camera.CFrame.Position, (targetPart.Position - camera.CFrame.Position), rayParams)
									if not rayResult or rayResult.Instance:IsDescendantOf(plr.Character) then
										best=targetPart; bestDist=dist
									end
								end
							end
						end
					end
				end
			end
		end
		if best then
			local targetCFrame=CFrame.new(camera.CFrame.Position,best.Position)
			camera.CFrame=camera.CFrame:Lerp(targetCFrame,settings.aimSmooth)
		end
	end)
end
local function toggleAim() if state.aim then stopAim() else startAim() end return state.aim end

-- ====== RIG ======
local function switchRig()
	refreshCharacter()
	if not char or not humanoid then return end
	local targetRig=(humanoid.RigType==Enum.HumanoidRigType.R6) and "R15" or "R6"
	local ok=pcall(function() player.AvatarType=(targetRig=="R6") and Enum.AvatarType.R6 or Enum.AvatarType.R15 end)
	if ok then player:LoadCharacter(); notify("Rig -> "..targetRig, true)
	else notify("Rig switch failed", false) end
end

-- ====== ESP ======
local function clearESP() for plr,hl in pairs(espHighlights) do if hl then hl:Destroy() end espHighlights[plr]=nil end end
local function applyHighlightSettings(hl) hl.FillColor=settings.espColor hl.OutlineColor=settings.espColor hl.FillTransparency=settings.espFill/100 hl.OutlineTransparency=0 hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop end
local function getModelForCharacter(c) if not c or not c:IsA("Model") then return nil end local hum=c:FindFirstChildOfClass("Humanoid") if not hum or hum.Health<=0 then return nil end return c end
local function updateESP()
	if not state.esp then return end
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr~=player then
			local model=getModelForCharacter(plr.Character)
			if model then
				local existing=espHighlights[plr]
				if not existing or not existing.Parent or existing.Adornee~=model then
					if existing then existing:Destroy() end
					local hl=Instance.new("Highlight") hl.Name="CallClientESP" hl.Adornee=model applyHighlightSettings(hl) hl.Parent=model espHighlights[plr]=hl
				else applyHighlightSettings(existing) end
			else if espHighlights[plr] then espHighlights[plr]:Destroy() espHighlights[plr]=nil end end
		end
	end
	for key,hl in pairs(espHighlights) do
		local valid=hl.Parent~=nil
		if valid and key:IsA("Player") then valid=key.Parent~=nil and key.Character~=nil end
		if not valid then hl:Destroy() espHighlights[key]=nil end
	end
end
local function startESP() state.esp=true if espThread then task.cancel(espThread) end updateESP() espThread=task.spawn(function() while state.esp do updateESP() task.wait(0.5) end end) end
local function stopESP() state.esp=false if espThread then task.cancel(espThread) espThread=nil end clearESP() end
local function toggleESP() if state.esp then stopESP() else startESP() end return state.esp end

