local toggleButtons={}
local function makeToggleButton(parent,key,label,order,onToggle)
	local btn=Instance.new("TextButton") btn.Size=UDim2.new(1,0,0,42) btn.BackgroundColor3=COL.panel btn.BackgroundTransparency=0.2 btn.Text="" btn.AutoButtonColor=false btn.LayoutOrder=order btn.Parent=parent Instance.new("UICorner",btn).CornerRadius=UDim.new(0,8) reg(btn,"panel")
