-- ====== ВКЛАДКИ ======
local keybindsTabBtn=makeTab("Keybinds",1)
local commandsTabBtn=makeTab("Commands",2)
local playersTabBtn=makeTab("Players",3)
local visualsTabBtn=makeTab("Visuals",4)
local hudTabBtn=makeTab("HUD",5)
local themeTabBtn=makeTab("Theme",6)
local pages={ Keybinds=keybindsPage,Commands=commandsPage,Players=playersPage,Visuals=visualsPage,HUD=hudPage,Theme=themePage }
local function setTab(tabName)
	for tName,t in pairs(tabs) do
		local active=(tName==tabName)
		t.button:SetAttribute("Active",active) t.button.BackgroundColor3=active and COL.itemHov or COL.item t.button.TextColor3=active and COL.text or COL.muted
		t.marker.Visible=active t.marker.Size=active and UDim2.new(0,3,0,20) or UDim2.new(0,3,0,0)
	end
	for pName,page in pairs(pages) do page.Visible=(pName==tabName) end
end
keybindsTabBtn.MouseButton1Click:Connect(function() setTab("Keybinds") end)
commandsTabBtn.MouseButton1Click:Connect(function() setTab("Commands") end)
playersTabBtn.MouseButton1Click:Connect(function() setTab("Players") end)
visualsTabBtn.MouseButton1Click:Connect(function() setTab("Visuals") end)
hudTabBtn.MouseButton1Click:Connect(function() setTab("HUD") end)
themeTabBtn.MouseButton1Click:Connect(function() setTab("Theme") end)
setTab("Keybinds")

-- ====== ОТКРЫТИЕ / ЗАКРЫТИЕ ======
local isOpen=false
local function setOpen(newState)
	isOpen=newState
	if newState then
		mainFrame.Visible=true mainFrame.Size=UDim2.new(0,MAIN_W,0,MAIN_H-20)
		TweenService:Create(mainFrame,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(0,MAIN_W,0,MAIN_H)}):Play()
	else
		local tween=TweenService:Create(mainFrame,TweenInfo.new(0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Size=UDim2.new(0,MAIN_W,0,MAIN_H-20)})
		tween:Play()
		tween.Completed:Connect(function() if not isOpen then mainFrame.Visible=false end end)
	end
end
local function runToggle(key,toggleFn,label)
	toggleFn()
	if toggleButtons[key] then toggleButtons[key]() end
	notify(label..": "..(isOn(key) and "ON" or "OFF"), isOn(key))
end

UserInputService.InputBegan:Connect(function(input,gameProcessed)
	if rebinding then
		if input.UserInputType~=Enum.UserInputType.Keyboard then return end
		if input.KeyCode==Enum.KeyCode.Unknown then return end
		if input.KeyCode==Enum.KeyCode.Delete then rebinding=nil updateKeybindLabels() refreshHUD() return end
		binds[rebinding]=input.KeyCode
		local setFor = rebinding
		rebinding=nil
		updateKeybindLabels(); refreshHUD()
		rebuildKeybindList()
		notify("Bind set: "..bindNames[setFor].." -> "..keyName(binds[setFor]), true)
		return
	end
	if input.KeyCode==binds.toggle then if gameProcessed and not isOpen then return end setOpen(not isOpen) return end
	if binds.close and input.KeyCode==binds.close and isOpen then if gameProcessed then return end setOpen(false) return end
	if binds.fly and input.KeyCode==binds.fly then if gameProcessed then return end runToggle("fly",toggleFly,"Fly") return end
	if binds.noclip and input.KeyCode==binds.noclip then if gameProcessed then return end runToggle("noclip",toggleNoclip,"Noclip") return end
	if binds.fling and input.KeyCode==binds.fling then if gameProcessed then return end runToggle("fling",toggleFling,"Fling") return end
	if binds.esp and input.KeyCode==binds.esp then if gameProcessed then return end runToggle("esp",toggleESP,"ESP") return end
	if binds.aim and input.KeyCode==binds.aim then if gameProcessed then return end runToggle("aim",toggleAim,"Aim Assist") return end
	if binds.antifling and input.KeyCode==binds.antifling then if gameProcessed then return end runToggle("antifling",toggleAntifling,"Anti-Fling") return end
end)

closeBtn.MouseButton1Click:Connect(function() setOpen(false) end)

local dragging=false
local dragStart,startPos
header.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true dragStart=input.Position startPos=mainFrame.Position end end)
UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then local delta=input.Position-dragStart mainFrame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y) end end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
