			Instance.new("UICorner",specBtn).CornerRadius=UDim.new(0,7) reg(specBtn,"item")

			local flingBtn = Instance.new("TextButton")
			flingBtn.Size = UDim2.new(0, 54, 0, 26); flingBtn.Position = UDim2.new(1, -64, 0.5, 0); flingBtn.AnchorPoint = Vector2.new(0, 0.5)
			flingBtn.BackgroundColor3 = COL.close; flingBtn.Text = "Target Fling"; flingBtn.TextColor3 = Color3.new(1,1,1); flingBtn.Font = Enum.Font.GothamBold; flingBtn.TextSize = 10; flingBtn.AutoButtonColor = false; flingBtn.Parent = row
			Instance.new("UICorner", flingBtn).CornerRadius = UDim.new(0, 7) reg(flingBtn, "close")

