	local layout=Instance.new("UIListLayout") layout.Padding=UDim.new(0,7) layout.SortOrder=Enum.SortOrder.LayoutOrder layout.Parent=scroll
	return page,scroll
end

-- ====== KEYBINDS PAGE ======
local keybindsPage,kbScroll=makePage()
local keybindRows = {}

local function rebuildKeybindList()
	for _,v in ipairs(keybindRows) do v:Destroy() end
	keybindRows = {}
	keyButtons = {}
	local order = 2
	for _,special in ipairs({"toggle","close"}) do
		local row=Instance.new("Frame") row.Size=UDim2.new(1,0,0,38) row.BackgroundColor3=COL.panel row.BorderSizePixel=0 row.LayoutOrder=order row.Parent=kbScroll
		Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) reg(row,"panel")
		local keyBtn=Instance.new("TextButton") keyBtn.Size=UDim2.new(0,100,0,26) keyBtn.Position=UDim2.new(0,10,0.5,0) keyBtn.AnchorPoint=Vector2.new(0,0.5) keyBtn.BackgroundColor3=COL.item keyBtn.Text=keyName(binds[special]) keyBtn.TextColor3=COL.text keyBtn.Font=Enum.Font.GothamBold keyBtn.TextSize=11 keyBtn.AutoButtonColor=false keyBtn.Parent=row
		Instance.new("UICorner",keyBtn).CornerRadius=UDim.new(0,7) reg(keyBtn,"item")
		local kStroke=Instance.new("UIStroke") kStroke.Color=COL.stroke kStroke.Thickness=1 kStroke.Parent=keyBtn
		local action=Instance.new("TextLabel") action.Size=UDim2.new(1,-120,1,0) action.Position=UDim2.new(0,120,0,0) action.BackgroundTransparency=1 action.Text=(special=="toggle" and "Открыть / закрыть меню" or "Закрыть меню") action.TextColor3=COL.text action.Font=Enum.Font.Gotham action.TextSize=12 action.TextXAlignment=Enum.TextXAlignment.Left action.Parent=row reg(action,"text","TextColor3")
		keyButtons[special]={button=keyBtn,stroke=kStroke}
		keyBtn.MouseButton1Click:Connect(function()
			if rebinding==special then rebinding=nil updateKeybindLabels() return end
			rebinding=special updateKeybindLabels()
		end)
		table.insert(keybindRows,row); order += 1
	end
	for _,bindName in ipairs(bindCommands) do
		local row=Instance.new("Frame") row.Size=UDim2.new(1,0,0,38) row.BackgroundColor3=COL.panel row.BorderSizePixel=0 row.LayoutOrder=order row.Parent=kbScroll
		Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) reg(row,"panel")
		local keyBtn=Instance.new("TextButton") keyBtn.Size=UDim2.new(0,100,0,26) keyBtn.Position=UDim2.new(0,10,0.5,0) keyBtn.AnchorPoint=Vector2.new(0,0.5) keyBtn.BackgroundColor3=COL.item keyBtn.Text=keyName(binds[bindName]) keyBtn.TextColor3=COL.text keyBtn.Font=Enum.Font.GothamBold keyBtn.TextSize=11 keyBtn.AutoButtonColor=false keyBtn.Parent=row
		Instance.new("UICorner",keyBtn).CornerRadius=UDim.new(0,7) reg(keyBtn,"item")
		local kStroke=Instance.new("UIStroke") kStroke.Color=COL.stroke kStroke.Thickness=1 kStroke.Parent=keyBtn
		local action=Instance.new("TextLabel") action.Size=UDim2.new(1,-160,1,0) action.Position=UDim2.new(0,120,0,0) action.BackgroundTransparency=1 action.Text=bindNames[bindName] action.TextColor3=COL.text action.Font=Enum.Font.Gotham action.TextSize=12 action.TextXAlignment=Enum.TextXAlignment.Left action.Parent=row reg(action,"text","TextColor3")
		local delBtn=Instance.new("TextButton") delBtn.Size=UDim2.new(0,26,0,26) delBtn.Position=UDim2.new(1,-34,0.5,0) delBtn.AnchorPoint=Vector2.new(0,0.5) delBtn.BackgroundColor3=COL.close delBtn.Text="x" delBtn.TextColor3=Color3.new(1,1,1) delBtn.Font=Enum.Font.GothamBold delBtn.TextSize=14 delBtn.AutoButtonColor=false delBtn.Parent=row
		Instance.new("UICorner",delBtn).CornerRadius=UDim.new(0,7)
		delBtn.MouseButton1Click:Connect(function()
			binds[bindName]=nil
			updateKeybindLabels(); refreshHUD()
			rebuildKeybindList()
			notify(bindNames[bindName].." bind removed", false)
		end)
		keyButtons[bindName]={button=keyBtn,stroke=kStroke}
		keyBtn.MouseButton1Click:Connect(function()
			if rebinding==bindName then rebinding=nil updateKeybindLabels() return end
			rebinding=bindName updateKeybindLabels()
		end)
		table.insert(keybindRows,row); order += 1
	end
	local addRow=Instance.new("Frame") addRow.Size=UDim2.new(1,0,0,36) addRow.BackgroundTransparency=1 addRow.LayoutOrder=order addRow.Parent=kbScroll
	table.insert(keybindRows,addRow)
	local addBtn=Instance.new("TextButton") addBtn.Size=UDim2.new(1,0,1,0) addBtn.BackgroundColor3=COL.accent addBtn.Text="+ Add / Rebind" addBtn.TextColor3=Color3.new(1,1,1) addBtn.Font=Enum.Font.GothamBold addBtn.TextSize=12 addBtn.AutoButtonColor=false addBtn.Parent=addRow
	Instance.new("UICorner",addBtn).CornerRadius=UDim.new(0,8) reg(addBtn,"accent")
	addBtn.MouseButton1Click:Connect(function()
		local popup = Instance.new("Frame")
		popup.Size = UDim2.new(0, 260, 0, 300)
		popup.Position = UDim2.new(0.5, -130, 0.5, -150)
		popup.BackgroundColor3 = COL.panel
		popup.BorderSizePixel = 0
		popup.ZIndex = 50
		popup.Parent = screenGui
		Instance.new("UICorner", popup).CornerRadius = UDim.new(0, 12)
		local ps = Instance.new("UIStroke"); ps.Color = COL.accent; ps.Thickness = 1; ps.Transparency = 0.2; ps.Parent = popup
		local pt = Instance.new("TextLabel")
		pt.Size = UDim2.new(1, -20, 0, 30); pt.Position = UDim2.new(0, 10, 0, 8)
		pt.BackgroundTransparency = 1; pt.Text = "Выберите команду для бинда"
		pt.TextColor3 = COL.text; pt.Font = Enum.Font.GothamBold; pt.TextSize = 13
		pt.TextXAlignment = Enum.TextXAlignment.Left; pt.ZIndex = 51; pt.Parent = popup
		local pClose = Instance.new("TextButton")
		pClose.Size = UDim2.new(0, 24, 0, 24); pClose.Position = UDim2.new(1, -32, 0, 8)
		pClose.BackgroundColor3 = COL.close; pClose.Text = "X"; pClose.TextColor3 = Color3.new(1,1,1)
		pClose.Font = Enum.Font.GothamBold; pClose.TextSize = 12; pClose.AutoButtonColor = false
		pClose.ZIndex = 51; pClose.Parent = popup
		Instance.new("UICorner", pClose).CornerRadius = UDim.new(0, 6)
		pClose.MouseButton1Click:Connect(function() popup:Destroy() end)
		local pl = Instance.new("UIListLayout")
		pl.Padding = UDim.new(0, 6); pl.SortOrder = Enum.SortOrder.LayoutOrder; pl.Parent = popup
		local pp = Instance.new("UIPadding")
		pp.PaddingTop = UDim.new(0, 44); pp.PaddingLeft = UDim.new(0, 10)
		pp.PaddingRight = UDim.new(0, 10); pp.PaddingBottom = UDim.new(0, 10); pp.Parent = popup
		for i, cmd in ipairs(bindCommands) do
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, 0, 0, 32); b.BackgroundColor3 = COL.item
			b.Text = bindNames[cmd]..(binds[cmd] and ("  ["..keyName(binds[cmd]).."]") or "  [-]" )
			b.TextColor3 = COL.text; b.Font = Enum.Font.GothamMedium; b.TextSize = 12
			b.TextXAlignment = Enum.TextXAlignment.Left; b.AutoButtonColor = false
			b.LayoutOrder = i; b.ZIndex = 51; b.Parent = popup
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
			local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 10); pad.Parent = b
			b.MouseButton1Click:Connect(function()
				popup:Destroy()
				binds[cmd] = Enum.KeyCode.Unknown
				rebinding = cmd
				updateKeybindLabels()
				rebuildKeybindList()
				notify("Нажмите клавишу для "..bindNames[cmd], nil)
			end)
		end
	end)
end
makeSectionLabel(kbScroll,"KEYBINDS",1)
rebuildKeybindList()

-- ====== COMMANDS PAGE ======
local commandsPage,cmdScroll=makePage()
local toggleButtons={}
local function makeToggleButton(parent,key,label,order,onToggle)
	local btn=Instance.new("TextButton") btn.Size=UDim2.new(1,0,0,42) btn.BackgroundColor3=COL.panel btn.Text="" btn.AutoButtonColor=false btn.LayoutOrder=order btn.Parent=parent
	Instance.new("UICorner",btn).CornerRadius=UDim.new(0,8) reg(btn,"panel")
	local bStroke=Instance.new("UIStroke") bStroke.Color=COL.stroke bStroke.Thickness=1 bStroke.Parent=btn
	local labelLbl=Instance.new("TextLabel") labelLbl.Size=UDim2.new(1,-70,1,0) labelLbl.Position=UDim2.new(0,12,0,0) labelLbl.BackgroundTransparency=1 labelLbl.Text=label labelLbl.TextColor3=COL.text labelLbl.Font=Enum.Font.GothamMedium labelLbl.TextSize=13 labelLbl.TextXAlignment=Enum.TextXAlignment.Left labelLbl.Parent=btn reg(labelLbl,"text","TextColor3")
	local ind=Instance.new("Frame") ind.Size=UDim2.new(0,42,0,22) ind.Position=UDim2.new(1,-52,0.5,0) ind.AnchorPoint=Vector2.new(0,0.5) ind.BackgroundColor3=COL.off ind.BorderSizePixel=0 ind.Parent=btn
	Instance.new("UICorner",ind).CornerRadius=UDim.new(1,0)
	local indLbl=Instance.new("TextLabel") indLbl.Size=UDim2.new(1,0,1,0) indLbl.BackgroundTransparency=1 indLbl.Text="OFF" indLbl.TextColor3=Color3.new(1,1,1) indLbl.Font=Enum.Font.GothamBold indLbl.TextSize=10 indLbl.Parent=ind
	local function refresh()
		local on = isOn(key)
		ind.BackgroundColor3 = on and COL.on or COL.off
		indLbl.Text = on and "ON" or "OFF"
		bStroke.Color = on and COL.on or COL.stroke
	end
	btn.MouseButton1Click:Connect(function()
		onToggle()
		refresh()
		notify(label..": "..(isOn(key) and "ON" or "OFF"), isOn(key))
	end)
	toggleButtons[key]=refresh refresh() return btn
end

local function makeSlider(parent,key,label,minVal,maxVal,step,order,formatFn,onChanged)
	local row=Instance.new("Frame") row.Size=UDim2.new(1,0,0,58) row.BackgroundColor3=COL.panel row.BorderSizePixel=0 row.LayoutOrder=order row.Parent=parent
	Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) reg(row,"panel")
	local nameLbl=Instance.new("TextLabel") nameLbl.Size=UDim2.new(1,-70,0,18) nameLbl.Position=UDim2.new(0,12,0,6) nameLbl.BackgroundTransparency=1 nameLbl.Text=label nameLbl.TextColor3=COL.text nameLbl.Font=Enum.Font.GothamMedium nameLbl.TextSize=12 nameLbl.TextXAlignment=Enum.TextXAlignment.Left nameLbl.Parent=row reg(nameLbl,"text","TextColor3")
	local valueLbl=Instance.new("TextLabel") valueLbl.Size=UDim2.new(0,70,0,18) valueLbl.Position=UDim2.new(1,-82,0,6) valueLbl.BackgroundTransparency=1 valueLbl.Text=formatFn(settings[key]) valueLbl.TextColor3=COL.accent valueLbl.Font=Enum.Font.GothamBold valueLbl.TextSize=12 valueLbl.TextXAlignment=Enum.TextXAlignment.Right valueLbl.Parent=row reg(valueLbl,"accent","TextColor3")
	local track=Instance.new("Frame") track.Size=UDim2.new(1,-24,0,5) track.Position=UDim2.new(0,12,0,38) track.BackgroundColor3=COL.item track.BorderSizePixel=0 track.Parent=row
	Instance.new("UICorner",track).CornerRadius=UDim.new(1,0) reg(track,"item")
	local fill=Instance.new("Frame") fill.Size=UDim2.new((settings[key]-minVal)/(maxVal-minVal),0,1,0) fill.BackgroundColor3=COL.accent fill.BorderSizePixel=0 fill.Parent=track
	Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0) reg(fill,"accent")
	local thumb=Instance.new("TextButton") thumb.Size=UDim2.new(0,14,0,14) thumb.AnchorPoint=Vector2.new(0.5,0.5) thumb.Position=UDim2.new(fill.Size.X.Scale,0,0.5,0) thumb.BackgroundColor3=Color3.new(1,1,1) thumb.Text="" thumb.AutoButtonColor=false thumb.Parent=track
	Instance.new("UICorner",thumb).CornerRadius=UDim.new(1,0)
	local dragging=false
	local function updateFromX(x)
		local rel=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
		local raw=minVal+rel*(maxVal-minVal)
		local snapped=math.floor(raw/step+0.5)*step
		snapped=math.clamp(snapped,minVal,maxVal)
		settings[key]=snapped
		local s=(snapped-minVal)/(maxVal-minVal)
		fill.Size=UDim2.new(s,0,1,0) thumb.Position=UDim2.new(s,0,0.5,0) valueLbl.Text=formatFn(snapped)
		if onChanged then onChanged(snapped) end
	end
	thumb.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true end end)
	track.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true updateFromX(input.Position.X) end end)
	UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then updateFromX(input.Position.X) end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
	return row
end

