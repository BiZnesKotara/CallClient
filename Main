	local c=parseHex(espColorBox.Text)
	if c then settings.espColor=c espPreview.BackgroundColor3=c for _,hl in pairs(espHighlights) do applyHighlightSettings(hl) end
	else espColorBox.Text=string.format("#%02X%02X%02X",math.floor(settings.espColor.R*255),math.floor(settings.espColor.G*255),math.floor(settings.espColor.B*255)) end
end)
