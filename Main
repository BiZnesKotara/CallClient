local function parseHex(hex) hex=hex:gsub("#","") if #hex~=6 then return nil end local r=tonumber(hex:sub(1,2),16) local g=tonumber(hex:sub(3,4),16) local b=tonumber(hex:sub(5,6),16) if not(r and g and b) then return nil end return Color3.fromRGB(r,g,b) end
espColorBox.FocusLost:Connect(function() local c=parseHex(espColorBox.Text) if c then settings.espColor=c espPreview.BackgroundColor3=c for _,hl in pairs(espHighlights) do applyHighlightSettings(hl) end else espColorBox.Text=string.format("#%02X%02X%02X",math.floor(settings.espColor.R*255),math.floor(settings.espColor.G*255),math.floor(settings.espColor.B*255)) end end)
