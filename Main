-- ====== VISUAL WORLD ======
local visualDefaults = {
	brightness = Lighting.Brightness,
	ambient = Lighting.Ambient,
	outdoor = Lighting.OutdoorAmbient,
	fogEnd = Lighting.FogEnd,
	fogStart = Lighting.FogStart,
	clock = Lighting.ClockTime,
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere"),
}
local originalSkies = {}
for _,obj in ipairs(Lighting:GetChildren()) do
	if obj:IsA("Sky") then
		table.insert(originalSkies, obj)
	end
end

local function applyClockTime(t)
	settings.clockTime = t
	Lighting.ClockTime = t
end

local function setFullbright(on)
	state.fullbright = on
	if on then
		Lighting.Brightness = 3
		Lighting.Ambient = Color3.fromRGB(200,200,200)
		Lighting.OutdoorAmbient = Color3.fromRGB(200,200,200)
		Lighting.GlobalShadows = false
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then atm.Density = 0 end
	else
		Lighting.Brightness = visualDefaults.brightness
		Lighting.Ambient = visualDefaults.ambient
		Lighting.OutdoorAmbient = visualDefaults.outdoor
		Lighting.GlobalShadows = true
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm and visualDefaults.atmosphere then atm.Density = visualDefaults.atmosphere.Density end
	end
end

local function setNoFog(on)
	state.noFog = on
	if on then
		Lighting.FogEnd = 100000
		Lighting.FogStart = 100000
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then atm.Density = 0; atm.Haze = 0 end
	else
		Lighting.FogEnd = visualDefaults.fogEnd
		Lighting.FogStart = visualDefaults.fogStart
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm and visualDefaults.atmosphere then
			atm.Density = visualDefaults.atmosphere.Density
			atm.Haze = visualDefaults.atmosphere.Haze
		end
	end
end

-- Пресеты неба
local SkyPresets = {
	{ name = "Purple (Default)", id = 1 },
	{ name = "Blue Night", id = 2 },
	{ name = "Aurora Mountains", id = 3 },
	{ name = "Tropic", id = 4 },
}
local SkyAssets = {
	[1] = { Bk="rbxassetid://159454299", Dn="rbxassetid://159454296", Ft="rbxassetid://159454293", Lf="rbxassetid://159454286", Rt="rbxassetid://159454300", Up="rbxassetid://159454288", Sun="rbxassetid://6196665106", Moon="rbxassetid://6196665106" },
	[2] = { Bk="rbxassetid://1233158420", Dn="rbxassetid://1233158838", Ft="rbxassetid://1233157105", Lf="rbxassetid://1233157640", Rt="rbxassetid://1233157995", Up="rbxassetid://1233159158", Sun="rbxassetid://6196665106", Moon="rbxassetid://6196665106" },
	[3] = { Bk="rbxassetid://126146408999925", Dn="rbxassetid://118112392224589", Ft="rbxassetid://121253817183621", Lf="rbxassetid://134105463289425", Rt="rbxassetid://89099449712918", Up="rbxassetid://138429250948648", Sun="rbxassetid://6196665106", Moon="rbxassetid://6196665106" },
	[4] = { Bk="rbxassetid://169210090", Dn="rbxassetid://169210108", Ft="rbxassetid://169210121", Lf="rbxassetid://169210133", Rt="rbxassetid://169210143", Up="rbxassetid://169210149", Sun="rbxassetid://6196665106", Moon="rbxassetid://6196665106" },
}

local function setCustomSky(on, presetId)
	state.customSky = on
	if presetId then settings.skyPreset = presetId end
	if on then
		for _,sky in ipairs(originalSkies) do if sky.Parent then sky.Parent = nil end end
		local sky = Lighting:FindFirstChild("CallClientSky")
		if not sky then
			sky = Instance.new("Sky")
			sky.Name = "CallClientSky"
			sky.StarCount = 3000
			sky.CelestialBodiesShown = true
			sky.Parent = Lighting
		end
		local asset = SkyAssets[settings.skyPreset] or SkyAssets[1]
		sky.SkyboxBk = asset.Bk; sky.SkyboxDn = asset.Dn
		sky.SkyboxFt = asset.Ft; sky.SkyboxLf = asset.Lf
		sky.SkyboxRt = asset.Rt; sky.SkyboxUp = asset.Up
		sky.SunTextureId = asset.Sun; sky.MoonTextureId = asset.Moon
	else
		local sky = Lighting:FindFirstChild("CallClientSky")
		if sky then sky:Destroy() end
		for _,s in ipairs(originalSkies) do if not s.Parent then s.Parent = Lighting end end
	end
end

-- Trail
local trailAttachment0, trailAttachment1, trailInstance
local function updateTrailColor()
	if trailInstance then
		trailInstance.Color = ColorSequence.new(COL.accent, COL.accent:Lerp(Color3.new(1,1,1), 0.6))
	end
end
onTheme(updateTrailColor)

function stopTrail()
	state.trail = false
	if trailInstance then trailInstance:Destroy() trailInstance = nil end
	if trailAttachment0 then trailAttachment0:Destroy() trailAttachment0 = nil end
	if trailAttachment1 then trailAttachment1:Destroy() trailAttachment1 = nil end
end
function startTrail()
	refreshCharacter()
	if not char or not hrp then return end
	state.trail = true
	trailAttachment0 = Instance.new("Attachment", hrp)
	trailAttachment0.Position = Vector3.new(0, 0.5, 0.5)
	trailAttachment1 = Instance.new("Attachment", hrp)
	trailAttachment1.Position = Vector3.new(0, -0.5, 0.5)
	trailInstance = Instance.new("Trail")
	trailInstance.Attachment0 = trailAttachment0
	trailInstance.Attachment1 = trailAttachment1
	trailInstance.Lifetime = settings.trailLifetime
	trailInstance.MinLength = 0.05
	trailInstance.Color = ColorSequence.new(COL.accent, COL.accent:Lerp(Color3.new(1,1,1), 0.6))
	trailInstance.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1) })
	trailInstance.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0,1), NumberSequenceKeypoint.new(1,0) })
	trailInstance.FaceCamera = true
	trailInstance.Parent = hrp
end
local function toggleTrail()
	if state.trail then stopTrail() else startTrail() end
	return state.trail
end

-- Motion Blur
local motionBlurEffect = nil
local currentBlurSize = 0
local lastCameraCFrame = nil
local function setMotionBlur(on)
	state.motionBlur = on
	if not on then
		if motionBlurEffect then motionBlurEffect:Destroy() motionBlurEffect = nil end
		currentBlurSize = 0
		lastCameraCFrame = nil
	end
end

RunService.RenderStepped:Connect(function(dt)
	if not state.motionBlur then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	local camCF = camera.CFrame
	if not motionBlurEffect then
		motionBlurEffect = Instance.new("BlurEffect")
		motionBlurEffect.Name = "CallClientMotionBlur"
		motionBlurEffect.Size = 0
		motionBlurEffect.Parent = Lighting
	end
	if lastCameraCFrame then
		local delta = (camCF.Position - lastCameraCFrame.Position).Magnitude
		local angleDelta = (camCF.LookVector - lastCameraCFrame.LookVector).Magnitude
		local speed = delta * 4 + angleDelta * 30
		local target = math.clamp(speed * settings.motionBlurStrength * 0.5, 0, settings.motionBlurStrength * 2)
		currentBlurSize = currentBlurSize + (target - currentBlurSize) * math.clamp(dt * 8, 0, 1)
		motionBlurEffect.Size = currentBlurSize
	end
	lastCameraCFrame = camCF
end)

