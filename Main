	for _,child in ipairs(playerListHolder:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr~=player then
			local row=Instance.new("Frame") row.Size=UDim2.new(1,0,0,40) row.BackgroundColor3=COL.panel row.BackgroundTransparency=0.2 row.BorderSizePixel=0 row.Parent=playerListHolder Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) reg(row,"panel")
