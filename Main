			local tpBtn=Instance.new("TextButton") tpBtn.Size=UDim2.new(0,54,0,26) tpBtn.Position=UDim2.new(1,-184,0.5,0) tpBtn.AnchorPoint=Vector2.new(0,0.5) tpBtn.BackgroundColor3=COL.accent tpBtn.Text="TP" tpBtn.TextColor3=Color3.new(1,1,1) tpBtn.Font=Enum.Font.GothamBold tpBtn.TextSize=11 tpBtn.AutoButtonColor=false tpBtn.Parent=row Instance.new("UICorner",tpBtn).CornerRadius=UDim.new(0,7) reg(tpBtn,"accent")
			local specBtn=Instance.new("TextButton") specBtn.Size=UDim2.new(0,54,0,26) specBtn.Position=UDim2.new(1,-124,0.5,0) specBtn.AnchorPoint=Vector2.new(0,0.5) specBtn.BackgroundColor3=COL.item specBtn.Text="View" specBtn.TextColor3=COL.text specBtn.Font=Enum.Font.GothamBold specBtn.TextSize=11 specBtn.AutoButtonColor=false specBtn.Parent=row Instance.new("UICorner",specBtn).CornerRadius=UDim.new(0,7) reg(specBtn,"item")
			local flingBtn = Instance.new("TextButton") flingBtn.Size = UDim2.new(0, 54, 0, 26); flingBtn.Position = UDim2.new(1, -64, 0.5, 0); flingBtn.AnchorPoint = Vector2.new(0, 0.5); flingBtn.BackgroundColor3 = COL.close; flingBtn.Text = "Target Fling"; flingBtn.TextColor3 = Color3.new(1,1,1); flingBtn.Font = Enum.Font.GothamBold; flingBtn.TextSize = 10; flingBtn.AutoButtonColor = false; flingBtn.Parent = row
			Instance.new("UICorner", flingBtn).CornerRadius = UDim.new(0, 7) reg(flingBtn, "close")

			local viewing=false
			tpBtn.MouseButton1Click:Connect(function() refreshCharacter() if not hrp or not plr.Character then return end local t=plr.Character:FindFirstChild("HumanoidRootPart") if t then hrp.CFrame=t.CFrame+Vector3.new(3,1,0) end end)
			specBtn.MouseButton1Click:Connect(function() refreshCharacter() if viewing then viewing=false if humanoid then workspace.CurrentCamera.CameraSubject=humanoid end specBtn.Text="View" else if plr.Character then viewing=true workspace.CurrentCamera.CameraSubject=plr.Character:FindFirstChildOfClass("Humanoid") or plr.Character specBtn.Text="Stop" end end end)
			flingBtn.MouseButton1Click:Connect(function() if targetFlingPlayer == plr then stopTargetFling() flingBtn.Text = "Target Fling" notify("Target Fling OFF", false) else startTargetFling(plr) flingBtn.Text = "Stop Fling" end end)
		end
	end
end
