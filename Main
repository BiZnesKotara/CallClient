-- ====== ТЕМЫ ======
local Themes = {
	Purple = { bg=Color3.fromRGB(18,18,24), header=Color3.fromRGB(26,26,36), side=Color3.fromRGB(22,22,30), panel=Color3.fromRGB(28,28,38), accent=Color3.fromRGB(120,90,255), accent2=Color3.fromRGB(80,200,255), stroke=Color3.fromRGB(60,60,80), text=Color3.fromRGB(235,235,245), muted=Color3.fromRGB(140,140,165), item=Color3.fromRGB(34,34,46), itemHov=Color3.fromRGB(46,46,62) },
	Dark = { bg=Color3.fromRGB(10,10,12), header=Color3.fromRGB(18,18,22), side=Color3.fromRGB(14,14,18), panel=Color3.fromRGB(20,20,26), accent=Color3.fromRGB(200,200,210), accent2=Color3.fromRGB(140,140,160), stroke=Color3.fromRGB(40,40,50), text=Color3.fromRGB(240,240,245), muted=Color3.fromRGB(120,120,130), item=Color3.fromRGB(28,28,34), itemHov=Color3.fromRGB(40,40,48) },
	Ocean = { bg=Color3.fromRGB(12,20,28), header=Color3.fromRGB(18,30,42), side=Color3.fromRGB(14,24,34), panel=Color3.fromRGB(20,34,46), accent=Color3.fromRGB(60,160,255), accent2=Color3.fromRGB(60,230,200), stroke=Color3.fromRGB(40,60,80), text=Color3.fromRGB(230,240,250), muted=Color3.fromRGB(120,150,180), item=Color3.fromRGB(26,42,58), itemHov=Color3.fromRGB(36,56,74) },
	Rose = { bg=Color3.fromRGB(24,14,18), header=Color3.fromRGB(36,20,28), side=Color3.fromRGB(28,16,22), panel=Color3.fromRGB(38,22,30), accent=Color3.fromRGB(255,100,160), accent2=Color3.fromRGB(255,160,200), stroke=Color3.fromRGB(70,40,60), text=Color3.fromRGB(250,230,240), muted=Color3.fromRGB(170,130,150), item=Color3.fromRGB(44,26,36), itemHov=Color3.fromRGB(58,36,48) },
}

local COL = {}
for k,v in pairs(Themes.Purple) do COL[k]=v end
COL.close=Color3.fromRGB(230,70,90) COL.on=Color3.fromRGB(70,210,140) COL.off=Color3.fromRGB(60,60,80)

local themeRefs = {}
local onThemeChanged = {}
local function reg(obj,color,prop) table.insert(themeRefs,{obj=obj,color=color,prop=prop or "BackgroundColor3"}) end
local function onTheme(fn) table.insert(onThemeChanged, fn) end
local function applyTheme(theme)
	for k,v in pairs(theme) do COL[k]=v end
	for _,ref in ipairs(themeRefs) do
		if ref.obj and ref.obj.Parent then
			local c=COL[ref.color]
			if c then
				if ref.prop=="TextColor3" then ref.obj.TextColor3=c
				elseif ref.prop=="Stroke" then ref.obj.Color=c
				else ref.obj.BackgroundColor3=c end
			end
		end
	end
	for _,fn in ipairs(onThemeChanged) do pcall(fn) end
end

-- ====== БИНДЫ ======
local bindCommands = {"fly","noclip","fling","esp","aim","antifling"}
local bindNames = { fly="Fly", noclip="Noclip", fling="Fling", esp="ESP", aim="Aim Assist", antifling="Anti-Fling" }
local binds = {
	toggle = Enum.KeyCode.RightShift,
	close = Enum.KeyCode.Delete,
	fly = Enum.KeyCode.F,
	noclip = Enum.KeyCode.N,
	fling = Enum.KeyCode.G,
	esp = Enum.KeyCode.E,
	aim = Enum.KeyCode.Q,
	antifling = Enum.KeyCode.H,
}
local rebinding=nil
local keyButtons={}
local keyDisplayNames={ RightShift="RShift",LeftShift="LShift",LeftControl="LCtrl",RightControl="RCtrl",Space="Space",Return="Enter",Backspace="Backsp",Delete="Del" }
local function keyName(k) if not k then return "—" end return keyDisplayNames[k.Name] or k.Name end
local refreshHUD

local function updateKeybindLabels()
	for bindName,data in pairs(keyButtons) do
		if rebinding==bindName then
			data.button.Text="..." data.button.TextColor3=COL.accent data.button.BackgroundColor3=COL.itemHov data.stroke.Color=COL.accent
		elseif binds[bindName]==nil then
			data.button.Text="—" data.button.TextColor3=COL.muted data.button.BackgroundColor3=COL.item data.stroke.Color=COL.stroke
		else
			data.button.Text=keyName(binds[bindName]) data.button.TextColor3=COL.text data.button.BackgroundColor3=COL.item data.stroke.Color=COL.stroke
		end
	end
	if refreshHUD then refreshHUD() end
end

-- ====== НАСТРОЙКИ / СОСТОЯНИЕ ======
local settings={
	flySpeed=60, flingPower=99999, espColor=Color3.fromRGB(120,90,255), espFill=60,
	walkSpeed=16, jumpPower=50,
	aimFov=200, aimSmooth=0.25, aimTarget="Head", aimMaxDist=10,
	hudShowBinds=true, showTargetHud=true,
	clockTime=14,
	trailEnabled=false, trailLifetime=0.5, trailWidth=0.15,
	motionBlurEnabled=false, motionBlurStrength=12, motionBlurSmoothness=0.15,
	fullbrightEnabled=false, noFogEnabled=false, customSkyEnabled=false,
	skyPreset=1,
}
local state={ fly=false, noclip=false, fling=false, esp=false, aim=false, antifling=false,
	trail=false, motionBlur=false, fullbright=false, noFog=false, customSky=false }

local function isOn(key)
	if state[key] ~= nil then return state[key] end
	if settings[key] ~= nil then return settings[key] end
	return false
end

