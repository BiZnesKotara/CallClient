local hudEntries = {}
refreshHUD = function()
	for _,v in pairs(hudEntries) do v:Destroy() end
	hudEntries = {}
	local order = 1
	for _,bindName in ipairs(bindCommands) do
		local key = binds[bindName]
		if key then
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 16); row.BackgroundTransparency = 1; row.LayoutOrder = order; row.Parent = hudFrame
			table.insert(hudEntries, row)
			local nameLbl = Instance.new("TextLabel")
			nameLbl.Size = UDim2.new(1, -60, 1, 0); nameLbl.BackgroundTransparency = 1
			nameLbl.Text = string.upper(bindName); nameLbl.TextColor3 = COL.text
			nameLbl.Font = Enum.Font.Gotham; nameLbl.TextSize = 10; nameLbl.TextXAlignment = Enum.TextXAlignment.Left; nameLbl.Parent = row
			reg(nameLbl, "text", "TextColor3")
			local keyLbl = Instance.new("TextLabel")
			keyLbl.Size = UDim2.new(0, 50, 1, 0); keyLbl.Position = UDim2.new(1, -50, 0, 0); keyLbl.BackgroundTransparency = 1
			keyLbl.Text = keyName(key); keyLbl.TextColor3 = COL.accent; keyLbl.Font = Enum.Font.GothamBold
			keyLbl.TextSize = 10; keyLbl.TextXAlignment = Enum.TextXAlignment.Right; keyLbl.Parent = row
			reg(keyLbl, "accent", "TextColor3")
			order += 1
		end
	end
end
refreshHUD()

