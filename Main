-- LocalScript: StarterPlayer > StarterPlayerScripts
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local old = playerGui:FindFirstChild("CallClient")
if old then old:Destroy() end

-- ====== LIQUID GLASS СТИЛЬ ======
local COL = { 
	bg=Color3.fromRGB(25, 25, 35), header=Color3.fromRGB(35, 35, 50), side=Color3.fromRGB(30, 30, 40), 
	panel=Color3.fromRGB(40, 40, 55), accent=Color3.fromRGB(140, 120, 255), accent2=Color3.fromRGB(100, 200, 255), 
	stroke=Color3.fromRGB(150, 150, 180), text=Color3.fromRGB(255, 255, 255), muted=Color3.fromRGB(180, 180, 200), 
	item=Color3.fromRGB(50, 50, 70), itemHov=Color3.fromRGB(65, 65, 90) 
}
COL.close=Color3.fromRGB(255,80,110) COL.on=Color3.fromRGB(80,220,150) COL.off=Color3.fromRGB(80,80,110)

local themeRefs = {}
local function reg(obj,color,prop) table.insert(themeRefs,{obj=obj,color=color,prop=prop or "BackgroundColor3"}) end
local function applyTheme(theme)
	for k,v in pairs(theme) do COL[k]=v end
	for _,ref in ipairs(themeRefs) do
		if ref.obj and ref.obj.Parent then
			local c=COL[ref.color]
			if c then
				if ref.prop=="TextColor3" then ref.obj.TextColor3=c
				elseif ref.prop=="Stroke" then ref.obj.Color=c
				else ref.obj.BackgroundColor3=c end
			end
		end
	end
end

-- ====== БИНДЫ ======
local binds = { toggle=Enum.KeyCode.RightShift, close=Enum.KeyCode.Delete, fly=Enum.KeyCode.F, noclip=Enum.KeyCode.N, fling=Enum.KeyCode.G, esp=Enum.KeyCode.E, aim=Enum.KeyCode.Q, antifling=Enum.KeyCode.H }
local bindNames = { fly="Fly", noclip="Noclip", fling="Fling", esp="ESP", aim="Aim Assist", antifling="Anti-Fling" }
local bindCommands = {"fly","noclip","fling","esp","aim","antifling"}
local rebinding=nil
local keyButtons={}
local keyDisplayNames={ RightShift="RShift",LeftShift="LShift",LeftControl="LCtrl",RightControl="RCtrl",Space="Space",Return="Enter",Backspace="Backsp",Delete="Del" }
local function keyName(k) if not k then return "—" end return keyDisplayNames[k.Name] or k.Name end
local refreshHUD

local function updateKeybindLabels()
	for bindName,data in pairs(keyButtons) do
		if rebinding==bindName then
			data.button.Text="..." data.button.TextColor3=COL.accent data.button.BackgroundColor3=COL.itemHov data.stroke.Color=COL.accent
		elseif binds[bindName]==nil then
			data.button.Text="—" data.button.TextColor3=COL.muted data.button.BackgroundColor3=COL.item data.stroke.Color=COL.stroke
		else
			data.button.Text=keyName(binds[bindName]) data.button.TextColor3=COL.text data.button.BackgroundColor3=COL.item data.stroke.Color=COL.stroke
		end
	end
	if refreshHUD then refreshHUD() end
end

-- ====== НАСТРОЙКИ ======
local settings = { flySpeed=60, flingPower=99999, espColor=Color3.fromRGB(140,120,255), espFill=60, walkSpeed=16, jumpPower=50, aimFov=200, aimSmooth=0.25, aimTarget="Head", aimMaxDist=10, hudShowBinds=true, showTargetHud=true }
local state = { fly=false, noclip=false, fling=false, esp=false, aim=false, antifling=false, invisible=false }
local function isOn(key) if state[key] ~= nil then return state[key] end if settings[key] ~= nil then return settings[key] end return false end

local char,hrp,humanoid
local flyConnection,noclipConnection,espThread,aimConnection
local flyBodyVelocity,flyBodyGyro, espHighlights={}
local flinging=false, flingConnection, flingDied
local targetFlingConnection, targetFlingPlayer

local function refreshCharacter()
	char=player.Character
	if not char then return end
	hrp=char:FindFirstChild("HumanoidRootPart")
	humanoid=char:FindFirstChildOfClass("Humanoid")
end
refreshCharacter()

-- ====== FLY ======
local function stopFly() state.fly=false if flyConnection then flyConnection:Disconnect() flyConnection=nil end if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity=nil end if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro=nil end if humanoid then humanoid.PlatformStand=false end end
local function startFly()
	refreshCharacter() if not hrp or not humanoid then return end state.fly=true humanoid.PlatformStand=true
	flyBodyVelocity=Instance.new("BodyVelocity") flyBodyVelocity.MaxForce=Vector3.new(1e5,1e5,1e5) flyBodyVelocity.Velocity=Vector3.zero flyBodyVelocity.Parent=hrp
	flyBodyGyro=Instance.new("BodyGyro") flyBodyGyro.MaxTorque=Vector3.new(1e5,1e5,1e5) flyBodyGyro.P=1000 flyBodyGyro.D=50 flyBodyGyro.CFrame=hrp.CFrame flyBodyGyro.Parent=hrp
	local camera=workspace.CurrentCamera
	flyConnection=RunService.RenderStepped:Connect(function()
		if not hrp or not humanoid or humanoid.Health<=0 then stopFly() return end
		local moveDir=Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir+=camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir-=camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir-=camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir+=camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir+=Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir-=Vector3.yAxis end
		if moveDir.Magnitude>0 then moveDir=moveDir.Unit end
		flyBodyVelocity.Velocity=moveDir*settings.flySpeed
		flyBodyGyro.CFrame=camera.CFrame
	end)
end
local function toggleFly() if state.fly then stopFly() else startFly() end return state.fly end

-- ====== NOCLIP ======
local function stopNoclip() state.noclip=false if noclipConnection then noclipConnection:Disconnect() noclipConnection=nil end end
local function startNoclip()
	refreshCharacter() state.noclip=true
	noclipConnection=RunService.Stepped:Connect(function()
		local c=player.Character if not c then return end for _,part in ipairs(c:GetDescendants()) do if part:IsA("BasePart") and part.CanCollide then part.CanCollide=false end end
	end)
end
local function toggleNoclip() if state.noclip then stopNoclip() else startNoclip() end return state.noclip end

-- ====== FLING ======
local function stopFling()
	flinging = false state.fling = false
	if flingConnection then pcall(function() task.cancel(flingConnection) end) flingConnection = nil end
	if flingDied then flingDied:Disconnect() flingDied = nil end
	refreshCharacter() if not char then return end
	for _, v in ipairs(char:GetDescendants()) do if v.Name:find("IYFling") then v:Destroy() end end
	for _, v in ipairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5) v.Massless = false v.CanCollide = true v.AssemblyLinearVelocity = Vector3.zero v.AssemblyAngularVelocity = Vector3.zero v.RotVelocity = Vector3.zero end end
	if humanoid then humanoid.AutoRotate = true humanoid.PlatformStand = false humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
	if hrp then hrp.AssemblyAngularVelocity = Vector3.zero hrp.AssemblyLinearVelocity = Vector3.zero end
end
local function startFling(silent)
	refreshCharacter() if not hrp or not humanoid then return end flinging = true state.fling = true
	for _, child in ipairs(char:GetDescendants()) do if child:IsA("BasePart") then if child == hrp then child.CanCollide = true child.Massless = false child.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5) else child.CanCollide = false child.Massless = true end end end
	humanoid.AutoRotate = false humanoid.PlatformStand = false
	local bambam = Instance.new("BodyAngularVelocity") bambam.Name = "IYFling_"..math.random(1,9999) bambam.Parent = hrp bambam.AngularVelocity = Vector3.new(0, settings.flingPower, 0) bambam.MaxTorque = Vector3.new(0, math.huge, 0) bambam.P = math.huge
	flingDied = humanoid.Died:Connect(function() if stopFling then stopFling() end end)
	flingConnection = task.spawn(function()
		while flinging do
			if not hrp or not humanoid or humanoid.Health <= 0 then break end
			if bambam and bambam.Parent then bambam.AngularVelocity = Vector3.new(0, settings.flingPower, 0) end
			local v = hrp.AssemblyLinearVelocity hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
			task.wait(0.2)
			if bambam and bambam.Parent then bambam.AngularVelocity = Vector3.zero end
			if hrp then local v2 = hrp.AssemblyLinearVelocity hrp.AssemblyLinearVelocity = Vector3.new(v2.X, 0, v2.Z) end
			task.wait(0.1)
		end
	end)
	if not silent then notify("Fling ON", true) end
end
local function toggleFling() if flinging then stopFling() else startFling() end return flinging end

-- ====== TARGET FLING ======
local function stopTargetFling() if targetFlingConnection then targetFlingConnection:Disconnect() targetFlingConnection = nil end targetFlingPlayer = nil if flinging then stopFling() end end
local function startTargetFling(target)
	stopTargetFling() if not target or not target.Character or not hrp or not humanoid then return end targetFlingPlayer = target startFling(true)
	targetFlingConnection = RunService.Heartbeat:Connect(function()
		refreshCharacter() if not hrp or not humanoid or not targetFlingPlayer or not targetFlingPlayer.Character then stopTargetFling() return end
		local tHrp = targetFlingPlayer.Character:FindFirstChild("HumanoidRootPart")
		if tHrp then
			local direction = (tHrp.Position - hrp.Position)
			if direction.Magnitude > 3 then
				local moveSpeed = math.max(humanoid.WalkSpeed, 16)
				local newPos = hrp.Position + (direction.Unit * moveSpeed * RunService.Heartbeat:Wait())
				hrp.CFrame = CFrame.new(newPos, Vector3.new(tHrp.Position.X, newPos.Y, tHrp.Position.Z))
			end
		end
	end)
end

-- ====== INVISIBLE ======
local function toggleInvisible()
	refreshCharacter() if not char or not humanoid then return end
	state.invisible = not state.invisible
	if state.invisible then
		for _, v in ipairs(char:GetDescendants()) do if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then v.Transparency = 1 end if v:IsA("Decal") then v.Transparency = 1 end end
	else
		for _, v in ipairs(char:GetDescendants()) do if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then v.Transparency = 0 end if v:IsA("Decal") then v.Transparency = 0 end end
	end
end

-- ====== ESP ======
local function clearESP() for plr,hl in pairs(espHighlights) do if hl then hl:Destroy() end espHighlights[plr]=nil end end
local function applyHighlightSettings(hl) hl.FillColor=settings.espColor hl.OutlineColor=settings.espColor hl.FillTransparency=settings.espFill/100 hl.OutlineTransparency=0 hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop end
local function updateESP()
	if not state.esp then return end
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr~=player then
			local model=plr.Character if model and model:FindFirstChildOfClass("Humanoid") and model:FindFirstChildOfClass("Humanoid").Health > 0 then
				local existing=espHighlights[plr] if not existing or not existing.Parent or existing.Adornee~=model then if existing then existing:Destroy() end local hl=Instance.new("Highlight") hl.Name="CallClientESP" hl.Adornee=model applyHighlightSettings(hl) hl.Parent=model espHighlights[plr]=hl else applyHighlightSettings(existing) end
			else if espHighlights[plr] then espHighlights[plr]:Destroy() espHighlights[plr]=nil end end
		end
	end
end
local function toggleESP() state.esp=not state.esp if state.esp then if espThread then task.cancel(espThread) end updateESP() espThread=task.spawn(function() while state.esp do updateESP() task.wait(0.5) end end) else if espThread then task.cancel(espThread) espThread=nil end clearESP() end return state.esp end

-- ====== AIM ======
local function toggleAim()
	state.aim = not state.aim

	if state.aim then
		aimConnection = RunService.RenderStepped:Connect(function()
			refreshCharacter()
			if not hrp or not humanoid or humanoid.Health <= 0 then
				return
			end

			local camera = workspace.CurrentCamera
			local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
			local best, bestDist = nil, math.huge

			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character then
					local hum = plr.Character:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						local targetPart = plr.Character:FindFirstChild(settings.aimTarget) or plr.Character:FindFirstChild("Head")
						if targetPart and (targetPart.Position - hrp.Position).Magnitude <= settings.aimMaxDist then
							local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
							if onScreen then
								local dist = (center - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
								if dist < settings.aimFov and dist < bestDist then
									best = targetPart
									bestDist = dist
								end
							end
						end
					end
				end
			end

			if best then
				camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, best.Position), settings.aimSmooth)
			end
		end)
	else
		if aimConnection then
			aimConnection:Disconnect()
			aimConnection = nil
		end
	end

	return state.aim
end

