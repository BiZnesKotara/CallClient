skyDropdown.MouseButton1Click:Connect(function()
	local popup = Instance.new("Frame")
	popup.Size = UDim2.new(0, 220, 0, #SkyPresets * 34 + 50)
	popup.Position = UDim2.new(0.5, -110, 0.5, -120)
	popup.BackgroundColor3 = COL.panel
	popup.BorderSizePixel = 0
	popup.ZIndex = 60
	popup.Parent = screenGui
	Instance.new("UICorner", popup).CornerRadius = UDim.new(0, 10)
	local ps = Instance.new("UIStroke"); ps.Color = COL.accent; ps.Thickness = 1; ps.Transparency = 0.2; ps.Parent = popup

	local head = Instance.new("Frame")
	head.Size = UDim2.new(1, 0, 0, 36)
	head.BackgroundTransparency = 1
	head.ZIndex = 61
	head.Parent = popup

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -40, 1, 0); title.Position = UDim2.new(0, 10, 0, 0)
	title.BackgroundTransparency = 1; title.Text = "Выберите небо"
	title.TextColor3 = COL.text; title.Font = Enum.Font.GothamBold; title.TextSize = 12
	title.TextXAlignment = Enum.TextXAlignment.Left; title.ZIndex = 61; title.Parent = head

	local closeP = Instance.new("TextButton")
	closeP.Size = UDim2.new(0, 24, 0, 24); closeP.Position = UDim2.new(1, -32, 0.5, 0)
	closeP.AnchorPoint = Vector2.new(0, 0.5)
	closeP.BackgroundColor3 = COL.close; closeP.Text = "X"; closeP.TextColor3 = Color3.new(1,1,1)
	closeP.Font = Enum.Font.GothamBold; closeP.TextSize = 12; closeP.AutoButtonColor = false
	closeP.ZIndex = 62; closeP.Parent = head
	Instance.new("UICorner", closeP).CornerRadius = UDim.new(0, 6)
	closeP.MouseButton1Click:Connect(function() popup:Destroy() end)

	local list = Instance.new("Frame")
	list.Size = UDim2.new(1, -12, 1, -40)
	list.Position = UDim2.new(0, 6, 0, 38)
	list.BackgroundTransparency = 1
	list.ZIndex = 61
	list.Parent = popup
	local pl = Instance.new("UIListLayout"); pl.Padding = UDim.new(0, 4); pl.SortOrder = Enum.SortOrder.LayoutOrder; pl.Parent = list

	for i, preset in ipairs(SkyPresets) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 30)
		btn.BackgroundColor3 = (settings.skyPreset == i) and COL.itemHov or COL.item
		btn.Text = preset.name
		btn.TextColor3 = COL.text
		btn.Font = Enum.Font.GothamMedium
		btn.TextSize = 12
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.AutoButtonColor = false
		btn.LayoutOrder = i
		btn.ZIndex = 61
		btn.Parent = list
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
		local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 10); pad.Parent = btn
		btn.MouseButton1Click:Connect(function()
			settings.skyPreset = i
			skyDropdown.Text = preset.name .. " v"
			if state.customSky then setCustomSky(true, i) end
			popup:Destroy()
			notify("Sky: " .. preset.name, true)
		end)
	end
end)

-- ClockTime slider
local clockRow=Instance.new("Frame") clockRow.Size=UDim2.new(1,0,0,58) clockRow.BackgroundColor3=COL.panel clockRow.BorderSizePixel=0 clockRow.LayoutOrder=15 clockRow.Parent=visScroll
Instance.new("UICorner",clockRow).CornerRadius=UDim.new(0,8) reg(clockRow,"panel")
local clockLbl=Instance.new("TextLabel") clockLbl.Size=UDim2.new(1,-70,0,18) clockLbl.Position=UDim2.new(0,12,0,6) clockLbl.BackgroundTransparency=1 clockLbl.Text="Time of Day" clockLbl.TextColor3=COL.text clockLbl.Font=Enum.Font.GothamMedium clockLbl.TextSize=12 clockLbl.TextXAlignment=Enum.TextXAlignment.Left clockLbl.Parent=clockRow reg(clockLbl,"text","TextColor3")
local clockVal=Instance.new("TextLabel") clockVal.Size=UDim2.new(0,70,0,18) clockVal.Position=UDim2.new(1,-82,0,6) clockVal.BackgroundTransparency=1 clockVal.Text=string.format("%.1f h",settings.clockTime) clockVal.TextColor3=COL.accent clockVal.Font=Enum.Font.GothamBold clockVal.TextSize=12 clockVal.TextXAlignment=Enum.TextXAlignment.Right clockVal.Parent=clockRow reg(clockVal,"accent","TextColor3")
local clockTrack=Instance.new("Frame") clockTrack.Size=UDim2.new(1,-24,0,5) clockTrack.Position=UDim2.new(0,12,0,38) clockTrack.BackgroundColor3=COL.item clockTrack.BorderSizePixel=0 clockTrack.Parent=clockRow
Instance.new("UICorner",clockTrack).CornerRadius=UDim.new(1,0) reg(clockTrack,"item")
local clockFill=Instance.new("Frame") clockFill.Size=UDim2.new(settings.clockTime/24,0,1,0) clockFill.BackgroundColor3=COL.accent clockFill.BorderSizePixel=0 clockFill.Parent=clockTrack
Instance.new("UICorner",clockFill).CornerRadius=UDim.new(1,0) reg(clockFill,"accent")
local clockThumb=Instance.new("TextButton") clockThumb.Size=UDim2.new(0,14,0,14) clockThumb.AnchorPoint=Vector2.new(0.5,0.5) clockThumb.Position=UDim2.new(clockFill.Size.X.Scale,0,0.5,0) clockThumb.BackgroundColor3=Color3.new(1,1,1) clockThumb.Text="" clockThumb.AutoButtonColor=false clockThumb.Parent=clockTrack
Instance.new("UICorner",clockThumb).CornerRadius=UDim.new(1,0)
local clockDragging=false
local function clockUpdate(x)
	local rel=math.clamp((x-clockTrack.AbsolutePosition.X)/clockTrack.AbsoluteSize.X,0,1)
	local val=math.floor(rel*24*10+0.5)/10
	applyClockTime(val)
	clockFill.Size=UDim2.new(val/24,0,1,0)
	clockThumb.Position=UDim2.new(val/24,0,0.5,0)
	clockVal.Text=string.format("%.1f h",val)
end
clockThumb.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then clockDragging=true end end)
clockTrack.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then clockDragging=true clockUpdate(i.Position.X) end end)
UserInputService.InputChanged:Connect(function(i) if clockDragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then clockUpdate(i.Position.X) end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then clockDragging=false end end)

