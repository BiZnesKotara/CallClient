local tabs={}
local function makeTab(tabName,order)
	local btn=Instance.new("TextButton") btn.Size=UDim2.new(1,0,0,34) btn.BackgroundColor3=COL.item btn.BackgroundTransparency=0.2 btn.Text="   "..tabName btn.TextColor3=COL.muted btn.Font=Enum.Font.GothamMedium btn.TextSize=13 btn.TextXAlignment=Enum.TextXAlignment.Left btn.LayoutOrder=order btn.AutoButtonColor=false btn.Parent=sidebar
	Instance.new("UICorner",btn).CornerRadius=UDim.new(0,9) reg(btn,"item")
	local mark=Instance.new("Frame") mark.Size=UDim2.new(0,3,0,0) mark.Position=UDim2.new(0,0,0.5,0) mark.AnchorPoint=Vector2.new(0,0.5) mark.BackgroundColor3=COL.accent mark.BorderSizePixel=0 mark.Visible=false mark.Parent=btn Instance.new("UICorner",mark).CornerRadius=UDim.new(0,2)
	btn.MouseEnter:Connect(function() if not btn:GetAttribute("Active") then TweenService:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=COL.itemHov, BackgroundTransparency=0.1}):Play() end end)
	btn.MouseLeave:Connect(function() if not btn:GetAttribute("Active") then TweenService:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=COL.item, BackgroundTransparency=0.2}):Play() end end)
	tabs[tabName]={button=btn,marker=mark} return btn
end

