local tabs={}
local function makeTab(tabName,order)
	local btn=Instance.new("TextButton") btn.Size=UDim2.new(1,0,0,34) btn.BackgroundColor3=COL.item btn.Text="   "..tabName btn.TextColor3=COL.muted btn.Font=Enum.Font.GothamMedium btn.TextSize=13 btn.TextXAlignment=Enum.TextXAlignment.Left btn.LayoutOrder=order btn.AutoButtonColor=false btn.Parent=sidebar
	Instance.new("UICorner",btn).CornerRadius=UDim.new(0,9) reg(btn,"item")
	local mark=Instance.new("Frame") mark.Size=UDim2.new(0,3,0,0) mark.Position=UDim2.new(0,0,0.5,0) mark.AnchorPoint=Vector2.new(0,0.5) mark.BackgroundColor3=COL.accent mark.BorderSizePixel=0 mark.Visible=false mark.Parent=btn Instance.new("UICorner",mark).CornerRadius=UDim.new(0,2)
	btn.MouseEnter:Connect(function() if not btn:GetAttribute("Active") then TweenService:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=COL.itemHov}):Play() end end)
	btn.MouseLeave:Connect(function() if not btn:GetAttribute("Active") then TweenService:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=COL.item}):Play() end end)
	tabs[tabName]={button=btn,marker=mark} return btn
end

local contentHost=Instance.new("Frame") contentHost.Size=UDim2.new(1,-150,1,-44) contentHost.Position=UDim2.new(0,150,0,44) contentHost.BackgroundTransparency=1 contentHost.Parent=mainFrame
local function makeSectionLabel(parent,text,order)
	local lbl=Instance.new("TextLabel") lbl.Size=UDim2.new(1,0,0,20) lbl.BackgroundTransparency=1 lbl.Text=text lbl.TextColor3=COL.muted lbl.Font=Enum.Font.GothamBold lbl.TextSize=10 lbl.TextXAlignment=Enum.TextXAlignment.Left lbl.LayoutOrder=order lbl.Parent=parent reg(lbl,"muted","TextColor3") return lbl
end
local function makePage()
	local page=Instance.new("Frame") page.Size=UDim2.new(1,0,1,0) page.BackgroundTransparency=1 page.Visible=false page.Parent=contentHost
	local scroll=Instance.new("ScrollingFrame") scroll.Size=UDim2.new(1,0,1,0) scroll.BackgroundTransparency=1 scroll.BorderSizePixel=0 scroll.ScrollBarThickness=2 scroll.ScrollBarImageColor3=COL.stroke scroll.CanvasSize=UDim2.new(0,0,0,0) scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y scroll.Parent=page
	local pad=Instance.new("UIPadding") pad.PaddingTop=UDim.new(0,12) pad.PaddingBottom=UDim.new(0,12) pad.PaddingLeft=UDim.new(0,14) pad.PaddingRight=UDim.new(0,14) pad.Parent=scroll
	local layout=Instance.new("UIListLayout") layout.Padding=UDim.new(0,7) layout.SortOrder=Enum.SortOrder.LayoutOrder layout.Parent=scroll
	return page,scroll
end

-- ====== ФУНКЦИИ UI ======
local toggleButtons={}
local function makeToggleButton(parent,key,label,order,onToggle)
	local btn=Instance.new("TextButton") btn.Size=UDim2.new(1,0,0,42) btn.BackgroundColor3=COL.panel btn.Text="" btn.AutoButtonColor=false btn.LayoutOrder=order btn.Parent=parent Instance.new("UICorner",btn).CornerRadius=UDim.new(0,8) reg(btn,"panel")
	local bStroke=Instance.new("UIStroke") bStroke.Color=COL.stroke bStroke.Thickness=1 bStroke.Parent=btn
	local labelLbl=Instance.new("TextLabel") labelLbl.Size=UDim2.new(1,-70,1,0) labelLbl.Position=UDim2.new(0,12,0,0) labelLbl.BackgroundTransparency=1 labelLbl.Text=label labelLbl.TextColor3=COL.text labelLbl.Font=Enum.Font.GothamMedium labelLbl.TextSize=13 labelLbl.TextXAlignment=Enum.TextXAlignment.Left labelLbl.Parent=btn reg(labelLbl,"text","TextColor3")
	local ind=Instance.new("Frame") ind.Size=UDim2.new(0,42,0,22) ind.Position=UDim2.new(1,-52,0.5,0) ind.AnchorPoint=Vector2.new(0,0.5) ind.BackgroundColor3=COL.off ind.BorderSizePixel=0 ind.Parent=btn Instance.new("UICorner",ind).CornerRadius=UDim.new(1,0)
	local indLbl=Instance.new("TextLabel") indLbl.Size=UDim2.new(1,0,1,0) indLbl.BackgroundTransparency=1 indLbl.Text="OFF" indLbl.TextColor3=Color3.new(1,1,1) indLbl.Font=Enum.Font.GothamBold indLbl.TextSize=10 indLbl.Parent=ind
	local function refresh() local on = isOn(key) ind.BackgroundColor3 = on and COL.on or COL.off indLbl.Text = on and "ON" or "OFF" bStroke.Color = on and COL.on or COL.stroke end
	btn.MouseButton1Click:Connect(function() onToggle() refresh() notify(label..": "..(isOn(key) and "ON" or "OFF"), isOn(key)) end)
	toggleButtons[key]=refresh refresh() return btn
end
local function makeSlider(parent,key,label,minVal,maxVal,step,order,formatFn,onChanged)
	local row=Instance.new("Frame") row.Size=UDim2.new(1,0,0,58) row.BackgroundColor3=COL.panel row.BorderSizePixel=0 row.LayoutOrder=order row.Parent=parent Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) reg(row,"panel")
	local nameLbl=Instance.new("TextLabel") nameLbl.Size=UDim2.new(1,-70,0,18) nameLbl.Position=UDim2.new(0,12,0,6) nameLbl.BackgroundTransparency=1 nameLbl.Text=label nameLbl.TextColor3=COL.text nameLbl.Font=Enum.Font.GothamMedium nameLbl.TextSize=12 nameLbl.TextXAlignment=Enum.TextXAlignment.Left nameLbl.Parent=row reg(nameLbl,"text","TextColor3")
	local valueLbl=Instance.new("TextLabel") valueLbl.Size=UDim2.new(0,70,0,18) valueLbl.Position=UDim2.new(1,-82,0,6) valueLbl.BackgroundTransparency=1 valueLbl.Text=formatFn(settings[key]) valueLbl.TextColor3=COL.accent valueLbl.Font=Enum.Font.GothamBold valueLbl.TextSize=12 valueLbl.TextXAlignment=Enum.TextXAlignment.Right valueLbl.Parent=row reg(valueLbl,"accent","TextColor3")
	local track=Instance.new("Frame") track.Size=UDim2.new(1,-24,0,5) track.Position=UDim2.new(0,12,0,38) track.BackgroundColor3=COL.item track.BorderSizePixel=0 track.Parent=row Instance.new("UICorner",track).CornerRadius=UDim.new(1,0) reg(track,"item")
	local fill=Instance.new("Frame") fill.Size=UDim2.new((settings[key]-minVal)/(maxVal-minVal),0,1,0) fill.BackgroundColor3=COL.accent fill.BorderSizePixel=0 fill.Parent=track Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0) reg(fill,"accent")
	local thumb=Instance.new("TextButton") thumb.Size=UDim2.new(0,14,0,14) thumb.AnchorPoint=Vector2.new(0.5,0.5) thumb.Position=UDim2.new(fill.Size.X.Scale,0,0.5,0) thumb.BackgroundColor3=Color3.new(1,1,1) thumb.Text="" thumb.AutoButtonColor=false thumb.Parent=track Instance.new("UICorner",thumb).CornerRadius=UDim.new(1,0)
	local dragging=false
	local function updateFromX(x) local rel=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1) local raw=minVal+rel*(maxVal-minVal) local snapped=math.floor(raw/step+0.5)*step snapped=math.clamp(snapped,minVal,maxVal) settings[key]=snapped local s=(snapped-minVal)/(maxVal-minVal) fill.Size=UDim2.new(s,0,1,0) thumb.Position=UDim2.new(s,0,0.5,0) valueLbl.Text=formatFn(snapped) if onChanged then onChanged(snapped) end end
	thumb.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true end end)
	track.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true updateFromX(input.Position.X) end end)
	UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then updateFromX(input.Position.X) end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
	return row
end

-- ====== ВКЛАДКА KEYBINDS ======
local keybindsPage,kbScroll=makePage()
local keybindRows = {}
local function rebuildKeybindList()
	for _,v in ipairs(keybindRows) do v:Destroy() end keybindRows = {} keyButtons = {}
	local order = 2
	for _,special in ipairs({"toggle","close"}) do
		local row=Instance.new("Frame") row.Size=UDim2.new(1,0,0,38) row.BackgroundColor3=COL.panel row.BorderSizePixel=0 row.LayoutOrder=order row.Parent=kbScroll Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) reg(row,"panel")
		local keyBtn=Instance.new("TextButton") keyBtn.Size=UDim2.new(0,100,0,26) keyBtn.Position=UDim2.new(0,10,0.5,0) keyBtn.AnchorPoint=Vector2.new(0,0.5) keyBtn.BackgroundColor3=COL.item keyBtn.Text=keyName(binds[special]) keyBtn.TextColor3=COL.text keyBtn.Font=Enum.Font.GothamBold keyBtn.TextSize=11 keyBtn.AutoButtonColor=false keyBtn.Parent=row Instance.new("UICorner",keyBtn).CornerRadius=UDim.new(0,7) reg(keyBtn,"item")
		local kStroke=Instance.new("UIStroke") kStroke.Color=COL.stroke kStroke.Thickness=1 kStroke.Parent=keyBtn
		local action=Instance.new("TextLabel") action.Size=UDim2.new(1,-120,1,0) action.Position=UDim2.new(0,120,0,0) action.BackgroundTransparency=1 action.Text=(special=="toggle" and "Открыть / закрыть меню" or "Закрыть меню") action.TextColor3=COL.text action.Font=Enum.Font.Gotham action.TextSize=12 action.TextXAlignment=Enum.TextXAlignment.Left action.Parent=row reg(action,"text","TextColor3")
		keyButtons[special]={button=keyBtn,stroke=kStroke}
		keyBtn.MouseButton1Click:Connect(function() if rebinding==special then rebinding=nil updateKeybindLabels() return end rebinding=special updateKeybindLabels() end)
		table.insert(keybindRows,row); order += 1
	end
	for _,bindName in ipairs(bindCommands) do
		local row=Instance.new("Frame") row.Size=UDim2.new(1,0,0,38) row.BackgroundColor3=COL.panel row.BorderSizePixel=0 row.LayoutOrder=order row.Parent=kbScroll Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) reg(row,"panel")
		local keyBtn=Instance.new("TextButton") keyBtn.Size=UDim2.new(0,100,0,26) keyBtn.Position=UDim2.new(0,10,0.5,0) keyBtn.AnchorPoint=Vector2.new(0,0.5) keyBtn.BackgroundColor3=COL.item keyBtn.Text=keyName(binds[bindName]) keyBtn.TextColor3=COL.text keyBtn.Font=Enum.Font.GothamBold keyBtn.TextSize=11 keyBtn.AutoButtonColor=false keyBtn.Parent=row Instance.new("UICorner",keyBtn).CornerRadius=UDim.new(0,7) reg(keyBtn,"item")
		local kStroke=Instance.new("UIStroke") kStroke.Color=COL.stroke kStroke.Thickness=1 kStroke.Parent=keyBtn
		local action=Instance.new("TextLabel") action.Size=UDim2.new(1,-160,1,0) action.Position=UDim2.new(0,120,0,0) action.BackgroundTransparency=1 action.Text=bindNames[bindName] action.TextColor3=COL.text action.Font=Enum.Font.Gotham action.TextSize=12 action.TextXAlignment=Enum.TextXAlignment.Left action.Parent=row reg(action,"text","TextColor3")
		local delBtn=Instance.new("TextButton") delBtn.Size=UDim2.new(0,26,0,26) delBtn.Position=UDim2.new(1,-34,0.5,0) delBtn.AnchorPoint=Vector2.new(0,0.5) delBtn.BackgroundColor3=COL.close delBtn.Text="x" delBtn.TextColor3=Color3.new(1,1,1) delBtn.Font=Enum.Font.GothamBold delBtn.TextSize=14 delBtn.AutoButtonColor=false delBtn.Parent=row Instance.new("UICorner",delBtn).CornerRadius=UDim.new(0,7)
		delBtn.MouseButton1Click:Connect(function() binds[bindName]=nil updateKeybindLabels(); refreshHUD() rebuildKeybindList() notify(bindNames[bindName].." bind removed", false) end)
		keyButtons[bindName]={button=keyBtn,stroke=kStroke}
		keyBtn.MouseButton1Click:Connect(function() if rebinding==bindName then rebinding=nil updateKeybindLabels() return end rebinding=bindName updateKeybindLabels() end)
		table.insert(keybindRows,row); order += 1
	end
end
makeSectionLabel(kbScroll,"KEYBINDS",1) rebuildKeybindList()

