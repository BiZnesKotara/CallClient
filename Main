reg(targetHudFrame, "panel")
local tHudStroke = Instance.new("UIStroke"); tHudStroke.Color = COL.accent; tHudStroke.Thickness = 1; tHudStroke.Transparency = 0.3; tHudStroke.Parent = targetHudFrame
local tName = Instance.new("TextLabel")
